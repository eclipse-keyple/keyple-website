        "owner": {
          "login": "SonarSource",
          "id": 545988,
          "node_id": "MDEyOk9yZ2FuaXphdGlvbjU0NTk4OA==",
          "avatar_url": "https://avatars.githubusercontent.com/u/545988?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/SonarSource",
          "html_url": "https://github.com/SonarSource",
