      "subscriptions_url": "https://api.github.com/users/jeanpierrefortune/subscriptions",
      "organizations_url": "https://api.github.com/users/jeanpierrefortune/orgs",
      "repos_url": "https://api.github.com/users/jeanpierrefortune/repos",
      "events_url": "https://api.github.com/users/jeanpierrefortune/events{/privacy}",
      "received_events_url": "https://api.github.com/users/jeanpierrefortune/received_events",
